.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Typescript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Angular CLI cache directory
.angular/

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# Playwright test artifacts
playwright-report/
test-results/
.browserslistrc

# TypeScript / Angular build output, regenerated per run.
# Narrow and anchored on purpose: a blanket `dist/` rule would hide future
# legitimate additions. Tracked files (dist/electron/*, dist/server/app.js,
# dist/server/app.js.map, dist/server/package.json) are unaffected - gitignore
# has no effect on already-tracked files; these rules only stop accidental
# staging of generated output such as dist/server/static/ and dist/test-out/.
/out-tsc/
/dist/out-tsc/
/dist/test-out/
/dist/server/
/dist/downloads/
