{
  "name": "duely",
  "productName": "Duely",
  "version": "2.0.0",
  "license": "MPL-2.0",
  "private": true,
  "bugs": {
    "url": "https://github.com/tubraunschweig/duely/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tubraunschweig/duely"
  },
  "author": "Duely Developer Team",
  "contributors": [
    "Till Affeldt <t.affeldt@tu-braunschweig.de>",
    "Marlen Bernier <marlen.bernier@tu-braunschweig.de>",
    "Mike Kenneth Braun <mike.braun@tu-braunschweig.de>",
    "Frederik Kammer <f.kammer@tu-braunschweig.de>",
    "Lars Richard <l.richard@tu-braunschweig.de>"
  ],
  "description": "A creator for recurring appointments",
  "keywords": [
    "appointment",
    "calendar",
    "iCal",
    "ics",
    "scheduler"
  ],
  "scripts": {
    "clean": "npm prune && rimraf ./dist",
    "start": "npm run start:electron",
    "start:server": "node ./dist/server/app.js",
    "start:electron": "electron ./dist/electron/index.js",
    "build": "node scripts/build.mjs --mode development",
    "build:prod": "node scripts/build.mjs --mode production",
    "build:watch": "node scripts/build.mjs --mode development --watch",
    "build:server": "node scripts/build.mjs --mode development --target server",
    "build:server:prod": "node scripts/build.mjs --mode production --target server",
    "build:electron": "node scripts/build.mjs --mode development --target electron",
    "build:electron:prod": "node scripts/build.mjs --mode production --target electron",
    "serve": "ng serve",
    "lint": "eslint .",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:coverage": "ng test --coverage --watch=false",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@angular/animations": "22.2.5",
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/material": "22.2.6",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@date-fns/tz": "1.5.0",
    "@ngx-translate/core": "18.1.0",
    "@ngx-translate/http-loader": "18.1.0",
    "compression": "1.8.2",
    "date-fns": "4.4.0",
    "date-holidays": "3.39.1",
    "express": "5.3.0",
    "file-saver": "^2.0.5",
    "ical-generator": "11.1.3",
    "rxjs": "~7.8.1",
    "tslib": "2.9.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "22.6.0",
    "@angular-eslint/eslint-plugin-template": "22.6.0",
    "@angular-eslint/template-parser": "22.6.0",
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "26.6.6",
    "angular-eslint": "22.6.0",
    "concurrently": "10.0.7",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "jsdom": "31.0.0",
    "rimraf": "6.1.4",
    "sass": "1.108.1",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "glob": "^14.0.4",
    "tar": "^7.5.22"
  },
  "engines": {
    "node": "^26.0.0",
    "npm": "^11.20.0"
  }
}
