{
  "name": "duely",
  "productName": "Duely",
  "version": "2.0.0",
  "license": "MPL-2.0",
  "private": true,
  "bugs": {
    "url": "https://github.com/tubraunschweig/duely/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tubraunschweig/duely"
  },
  "author": "Duely Developer Team",
  "contributors": [
    "Till Affeldt <t.affeldt@tu-braunschweig.de>",
    "Marlen Bernier <marlen.bernier@tu-braunschweig.de>",
    "Mike Kenneth Braun <mike.braun@tu-braunschweig.de>",
    "Frederik Kammer <f.kammer@tu-braunschweig.de>",
    "Lars Richard <l.richard@tu-braunschweig.de>"
  ],
  "description": "A creator for recurring appointments",
  "keywords": [
    "appointment",
    "calendar",
    "iCal",
    "ics",
    "scheduler"
  ],
  "scripts": {
    "clean": "npm prune && rimraf ./dist",
    "start": "npm run start:electron",
    "start:server": "node ./dist/server/app.js",
    "start:electron": "electron ./dist/electron/index.js",
    "build": "node scripts/build.mjs --mode development",
    "build:prod": "node scripts/build.mjs --mode production",
    "build:watch": "node scripts/build.mjs --mode development --watch",
    "build:server": "node scripts/build.mjs --mode development --target server",
    "build:server:prod": "node scripts/build.mjs --mode production --target server",
    "build:electron": "node scripts/build.mjs --mode development --target electron",
    "build:electron:prod": "node scripts/build.mjs --mode production --target electron",
    "serve": "ng serve",
    "lint": "eslint .",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:coverage": "ng test --coverage --watch=false",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@angular/animations": "^20.3.18",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.18",
    "@angular/compiler": "^20.3.18",
    "@angular/core": "^20.3.18",
    "@angular/forms": "^20.3.18",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.18",
    "@angular/router": "^20.3.18",
    "@ngx-translate/core": "^16.0.3",
    "@ngx-translate/http-loader": "^16.0.0",
    "compression": "^1.7.5",
    "date-holidays": "^3.24.0",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "ical-generator": "^7.2.0",
    "moment-timezone": "^0.5.47",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^20.7.0",
    "@angular-eslint/eslint-plugin-template": "^20.7.0",
    "@angular-eslint/template-parser": "^20.7.0",
    "@angular/build": "^20.3.23",
    "@angular/cli": "^20.3.23",
    "@angular/compiler-cli": "^20.3.18",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "electron": "^34.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "0.25.9",
    "eslint": "^9.17.0",
    "jsdom": "^26.1.0",
    "rimraf": "^6.0.1",
    "sass": "^1.83.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.1.0"
  },
  "overrides": {
    "glob": "^13.0.6",
    "tar": "^7.5.22"
  },
  "engines": {
    "node": ">= 24.0.0",
    "npm": ">= 10.2.0"
  }
}
