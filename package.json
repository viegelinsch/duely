{
  "name": "duely",
  "productName": "Duely",
  "version": "2.0.0",
  "license": "MPL v2.0",
  "private": true,
  "bugs": {
    "url": "https://github.com/tubraunschweig/duely/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tubraunschweig/duely"
  },
  "author": "Duely Developer Team",
  "contributors": [
    "Till Affeldt <t.affeldt@tu-braunschweig.de>",
    "Marlen Bernier <marlen.bernier@tu-braunschweig.de>",
    "Mike Kenneth Braun <mike.braun@tu-braunschweig.de>",
    "Frederik Kammer <f.kammer@tu-braunschweig.de>",
    "Lars Richard <l.richard@tu-braunschweig.de>"
  ],
  "description": "A creator for recurring appointments",
  "keywords": [
    "appointment",
    "calendar",
    "iCal",
    "ics",
    "scheduler"
  ],
  "scripts": {
    "clean": "npm prune && rimraf ./dist && rimraf ./doc",
    "start": "npm run start:electron",
    "start:server": "node ./dist/server/app.js",
    "start:electron": "electron ./dist/electron/index.js",
    "prebuild": "mkdirp ./dist/electron/static && mkdirp ./dist/server/static",
    "build": "webpack",
    "build:prod": "webpack --mode production",
    "build:watch": "webpack --watch",
    "build:server": "webpack --config webpack.server.config",
    "build:server:prod": "webpack --mode production --config webpack.server.config",
    "build:electron": "webpack --config webpack.electron.config",
    "build:electron:prod": "webpack --mode production --config webpack.electron.config",
    "serve": "webpack serve --mode development",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:coverage": "ng test --coverage --watch=false",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@angular/animations": "^20.3.18",
    "@angular/common": "^20.3.18",
    "@angular/compiler": "^20.3.18",
    "@angular/core": "^20.3.18",
    "@angular/forms": "^20.3.18",
    "@angular/platform-browser": "^20.3.18",
    "@angular/platform-browser-dynamic": "^20.3.18",
    "@angular/router": "^20.3.18",
    "@ngx-translate/core": "^16.0.3",
    "@ngx-translate/http-loader": "^16.0.0",
    "bootstrap": "^5.3.3",
    "ngx-bootstrap": "^21.0.1",
    "compression": "^1.7.5",
    "date-fns": "^4.1.0",
    "date-holidays": "^3.24.0",
    "moment-timezone": "^0.5.47",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "ical-generator": "^7.2.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.23",
    "@angular/build": "^20.3.23",
